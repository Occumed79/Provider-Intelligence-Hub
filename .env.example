# Provider Intelligence Hub environment template
# Copy these into Render environment variables. Do not commit real secrets.

# Shared
NODE_VERSION=22
NODE_ENV=production

# Frontend static site
PORT=3000
BASE_PATH=/
VITE_API_BASE_URL=https://provider-intelligence-hub-api.onrender.com

# Backend API service
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
FRONTEND_ORIGIN=https://provider-intelligence-hub-frontend.onrender.com

# Optional document intelligence
# TXT/CSV/XLS/XLSX are parsed locally. PDF/image/document uploads use LlamaParse when this key is present.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_TIER=cost_effective
