# Network Development Hub environment template
# One Render Node web service serves both the frontend and API.
# Do not commit real secrets.

NODE_VERSION=22
NODE_ENV=production
PORT=3000
BASE_PATH=/

# Production must point to the existing Neon PostgreSQL database.
# Example shape only; do not commit a real password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=verify-full

# Optional for local/split development only. Leave unset in unified production so
# the browser uses same-origin relative /api/* requests.
# VITE_API_BASE_URL=http://localhost:3001

# Document intelligence
# Local parsing remains available for TXT/CSV/XLS/XLSX/DOCX/text-layer PDFs and as the final OCR fallback.
# Cloud credentials below are optional. Keep them server-side only; never expose them as VITE_* variables.

# LlamaCloud / LlamaParse credential pool
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_API_KEY_2=
LLAMA_CLOUD_API_KEY_3=
LLAMA_CLOUD_API_KEY_4=
LLAMA_CLOUD_API_KEY_5=

# OCR.Space credential pool
OCRSPACE_API_KEY=
OCRSPACE_API_KEY_2=
OCRSPACE_API_KEY_3=
OCRSPACE_API_KEY_4=
OCRSPACE_API_KEY_5=

# Optiic credential pool
OPTIIC_API_KEY=
OPTIIC_API_KEY_2=
OPTIIC_API_KEY_3=
OPTIIC_API_KEY_4=
