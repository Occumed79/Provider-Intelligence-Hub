# Provider Intelligence Hub environment template
# Copy these into Render environment variables. Do not commit real secrets.

# Shared
NODE_VERSION=22
NODE_ENV=production

# Frontend static site
PORT=3000
BASE_PATH=/
VITE_API_BASE_URL=https://provider-intelligence-hub-api.onrender.com

# Backend API service
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
FRONTEND_ORIGIN=https://provider-intelligence-hub-frontend.onrender.com

# Document intelligence
# Local parsing remains available for TXT/CSV/XLS/XLSX/DOCX/text-layer PDFs and as the final OCR fallback.
# Cloud credentials below are optional. Never commit real keys to GitHub.

# LlamaCloud / LlamaParse credential pool
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_API_KEY_2=
LLAMA_CLOUD_API_KEY_3=
LLAMA_CLOUD_API_KEY_4=
LLAMA_CLOUD_API_KEY_5=

# OCR.Space credential pool
OCRSPACE_API_KEY=
OCRSPACE_API_KEY_2=
OCRSPACE_API_KEY_3=
OCRSPACE_API_KEY_4=
OCRSPACE_API_KEY_5=

# Optiic credential pool
OPTIIC_API_KEY=
OPTIIC_API_KEY_2=
OPTIIC_API_KEY_3=
OPTIIC_API_KEY_4=
