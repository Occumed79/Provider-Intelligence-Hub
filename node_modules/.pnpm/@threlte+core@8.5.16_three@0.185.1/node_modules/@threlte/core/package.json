{
  "name": "@threlte/core",
  "version": "8.5.16",
  "author": "Grischa Erbe <hello@legrisch.com> (https://legrisch.com)",
  "license": "MIT",
  "description": "A 3D framework for the web, built on top of Svelte and Three.js",
  "type": "module",
  "keywords": [
    "svelte",
    "three",
    "three.js",
    "webgl",
    "webgpu",
    "webxr",
    "3d"
  ],
  "homepage": "https://threlte.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/threlte/threlte",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/threlte/threlte/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "types": "./dist/types.d.ts",
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "package": "svelte-kit sync && svelte-package && node ./scripts/cleanupPackage.js && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "cleanup": "rimraf node_modules .svelte-kit dist"
  }
}
