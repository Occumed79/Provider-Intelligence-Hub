{
  "name": "tailwindcss-animate",
  "version": "1.0.7",
  "description": "A Tailwind CSS plugin for creating beautiful animations.",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "format": "prettier --write '**'",
    "format:check": "prettier --check '**'",
    "prepare": "husky install"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "css",
    "postcss",
    "plugin",
    "animation",
    "transition",
    "animate",
    "animated",
    "animatecss",
    "animate.css",
    "fade",
    "slide",
    "zoom",
    "spin",
    "opacity",
    "transform",
    "translate",
    "scale"
  ],
  "author": "Jamie Kyle <me@thejameskyle.com>",
  "license": "MIT",
  "lint-staged": {
    "*.**": "prettier --write"
  }
}
