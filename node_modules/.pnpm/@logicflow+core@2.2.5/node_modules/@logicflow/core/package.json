    "dev": "rss",
    "dev:esm": "rss",
    "dev:cjs": "rss",
    "build": "rss",
    "build:all": "rss",
    "prebuild": "rss",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node scripts/postinstall-ai-prompt.js"
