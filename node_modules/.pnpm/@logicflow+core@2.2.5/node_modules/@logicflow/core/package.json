  "description": "LogicFlow, help you quickly create flowcharts",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "homepage": "https://site.logic-flow.cn",
