{
  "name": "meow",
  "version": "9.0.0",
  "description": "CLI app helper",
  "license": "MIT",
  "repository": "sindresorhus/meow",
  "funding": "https://github.com/sponsors/sindresorhus",
  "author": {
    "name": "Sindre Sorhus",
    "email": "sindresorhus@gmail.com",
    "url": "https://sindresorhus.com"
  },
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "test": "xo && ava && tsd"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "keywords": [
    "cli",
    "bin",
    "util",
    "utility",
    "helper",
    "argv",
    "command",
    "line",
    "meow",
    "cat",
    "kitten",
    "parser",
    "option",
    "flags",
    "input",
    "cmd",
    "console"
  ],
  "xo": {
    "rules": {
      "unicorn/no-process-exit": "off",
      "node/no-unsupported-features/es-syntax": "off"
    },
    "ignores": [
      "estest/index.js"
    ]
  },
  "ava": {
    "files": [
      "test/*"
    ]
  }
}
