#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/ipfs-car@1.2.0/node_modules/ipfs-car/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/ipfs-car@1.2.0/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/ipfs-car@1.2.0/node_modules/ipfs-car/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/ipfs-car@1.2.0/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../ipfs-car/bin.js" "$@"
else
  exec node  "$basedir/../ipfs-car/bin.js" "$@"
fi
