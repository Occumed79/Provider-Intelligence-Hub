#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/glslify@7.1.1/node_modules/glslify/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/glslify@7.1.1/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/glslify@7.1.1/node_modules/glslify/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/glslify@7.1.1/node_modules:/home/runner/work/Provider-Intelligence-Hub/Provider-Intelligence-Hub/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../glslify/bin.js" "$@"
else
  exec node  "$basedir/../glslify/bin.js" "$@"
fi
