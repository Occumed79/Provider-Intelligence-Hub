  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./build/vega.module.js"
    },
    "./vega-schema.json": "./build/vega-schema.json"
  },
  "unpkg": "build/vega.min.js",
  "jsdelivr": "build/vega.min.js",
  "repository": {
    "type": "git",
