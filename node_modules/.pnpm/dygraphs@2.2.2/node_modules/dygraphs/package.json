    "url": "git+https://github.com/danvk/dygraphs.git"
  },
  "scripts": {
    "build": "mksh scripts/build.sh",
    "build-jsonly": "mksh scripts/build-js.sh",
    "clean": "mksh scripts/clean.sh",
