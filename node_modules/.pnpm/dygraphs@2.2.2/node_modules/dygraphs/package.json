    "prepack": "rm -rf _site && cp -Lr site _site && rm -f _site/LICENSE.txt _site/README.md && cp -Lr LICENSE.txt README.md _site/ && cd _site && mksh ../scripts/mkdiridx.sh --ah '<a href=\"https://www.npmjs.com/package/dygraphs\">dygraphs</a> manual integration tests' ./tests",
    "postpack": "rm -rf _site",
    "watch": "mksh scripts/watch.sh",
    "test": "mksh scripts/run-tests.sh",
    "test-min": "mksh scripts/run-tests.sh min",
    "tests-ok": "mksh scripts/check-no-only.sh"
  },
  "pre-commit": [
    "tests-ok"
  ],
