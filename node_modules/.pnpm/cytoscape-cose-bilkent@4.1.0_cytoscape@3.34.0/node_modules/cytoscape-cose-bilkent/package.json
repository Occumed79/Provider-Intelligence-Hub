  "description": "The CoSE layout for Cytoscape.js by Bilkent with enhanced compound node placement",
  "main": "cytoscape-cose-bilkent.js",
  "scripts": {
    "postpublish": "run-s gh-pages",
    "gh-pages": "gh-pages -d pages",
