  "license": "MIT",
  "files": [
    "dist/*",
    "lib/*"
  ],
  "types": "./dist/stats-gl.d.ts",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "exports": {
    ".": {
