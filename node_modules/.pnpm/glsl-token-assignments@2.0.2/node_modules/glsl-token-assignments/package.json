  },
  "keywords": [
    "ecosystem:stackgl",
    "pseudoparser",
    "syntax",
    "glsl",
    "tokens",
    "assignments",
    "declarations"
  ],
  "homepage": "https://github.com/stackgl/glsl-token-assignments",
  "bugs": {
