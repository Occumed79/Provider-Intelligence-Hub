{
  "name": "decompress",
  "version": "4.2.1",
  "description": "Extracting archives made easy",
  "license": "MIT",
  "repository": "kevva/decompress",
  "author": {
    "name": "Kevin Mårtensson",
    "email": "kevinmartensson@gmail.com",
