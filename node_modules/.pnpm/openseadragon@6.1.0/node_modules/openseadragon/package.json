{
  "name": "openseadragon",
  "version": "6.1.0",
  "description": "Provides a smooth, zoomable user interface for HTML/Javascript.",
  "keywords": [
    "image",
    "zoom",
    "pan",
    "openseadragon",
    "seadragon",
    "deepzoom",
    "dzi",
    "iiif",
    "osm",
    "osd",
    "tms"
  ],
  "homepage": "https://openseadragon.github.io/",
  "funding": "https://opencollective.com/openseadragon",
  "bugs": {
    "url": "https://github.com/openseadragon/openseadragon/issues"
  },
  "license": "BSD-3-Clause",
  "files": [
    "types/",
    "build/openseadragon/"
  ],
  "main": "build/openseadragon/openseadragon.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/openseadragon/openseadragon.git"
  },
  "scripts": {
    "test": "grunt test",
    "prepare": "grunt build",
    "build": "grunt build",
    "dev": "grunt dev",
    "bundlesize": "node scripts/check-bundle-size.js",
    "bundlesize:visualize": "source-map-explorer build/openseadragon/openseadragon.min.js --no-border-checks",
    "package": "grunt package"
  },
  "bundlesize": [
    {
      "path": "build/openseadragon/openseadragon.min.js",
      "maxSize": "95 kB",
      "compression": "gzip"
    },
    {
      "path": "build/openseadragon/openseadragon.min.js",
      "maxSize": "375 kB",
      "compression": "none"
    }
  ],
  "types": "types/index.d.ts",
  "tsd": {
    "directory": "test-dts"
  }
}
