{
  "name": "@visx/vendor",
  "version": "4.0.0",
  "description": "vendored packages for visx",
  "sideEffects": false,
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "repository": "https://github.com/airbnb/visx",
  "keywords": [
    "visx",
    "data",
    "visualizations",
    "charts"
  ],
  "author": "@williaster",
  "license": "MIT and ISC",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    "./d3-*": {
      "types": "./d3-*.d.ts",
      "import": "./esm/d3-*.js",
      "require": "./lib/d3-*.js"
    },
    "./internmap": {
      "import": "./esm/internmap.js",
      "require": "./lib/internmap.js"
    }
  },
  "files": [
    "lib/",
    "esm/",
    "vendor-cjs/",
    "./d3-*",
    "./internmap.js"
  ],
  "gitHead": "78839796081beb0370fc928cc922b21908bbabaf"
}
