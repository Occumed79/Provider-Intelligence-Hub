{
  "name": "@maplibre/vt-pbf",
  "version": "4.3.2",
  "description": "Serialize mapbox vector tiles to binary protobufs in javascript.",
  "main": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint index.ts lib/**/*.ts test/**/*.ts",
