{
  "name": "@tresjs/core",
  "type": "module",
  "version": "5.8.3",
  "description": "Declarative ThreeJS using Vue Components",
  "author": "Alvaro Saburido <hola@alvarosaburido.dev> (https://github.com/alvarosabu/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tresjs/tres.git",
    "directory": "packages/core"
  },
  "keywords": [
    "vue",
    "3d",
    "threejs",
    "three",
    "threejs-vue"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/tres.js",
    "./template-compiler-options": "./dist/template-compiler-options.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/tres.js",
  "module": "./dist/tres.js",
  "types": "./dist/tres.d.ts",
  "typesVersions": {
    "*": {
      "template-compiler-options": [
        "dist/template-compiler-options.d.mts"
      ]
    }
  },
  "files": [
    "*.d.ts",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "implicitDependencies": [
      "!@tresjs/core-*"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "build:analyze": "ANALYZE=true tsdown",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui --coverage.enabled=true",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit"
  }
}
