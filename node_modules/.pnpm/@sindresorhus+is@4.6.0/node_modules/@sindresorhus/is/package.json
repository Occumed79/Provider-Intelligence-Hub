{
  "name": "@sindresorhus/is",
  "version": "4.6.0",
  "description": "Type check values",
  "license": "MIT",
  "repository": "sindresorhus/is",
  "funding": "https://github.com/sindresorhus/is?sponsor=1",
  "author": {
    "name": "Sindre Sorhus",
    "email": "sindresorhus@gmail.com",
    "url": "https://sindresorhus.com"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "del dist && tsc",
    "test": "xo && ava",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "type",
    "types",
    "is",
    "check",
    "checking",
    "validate",
    "validation",
    "utility",
    "util",
    "typeof",
    "instanceof",
    "object",
    "assert",
    "assertion",
    "test",
    "kind",
    "primitive",
    "verify",
    "compare",
    "typescript",
    "typeguards",
    "types"
  ],
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ]
  },
  "xo": {
    "extends": "xo-typescript",
    "extensions": [
      "ts"
    ],
    "parserOptions": {
      "project": "./tsconfig.xo.json"
    },
    "globals": [
      "BigInt",
      "BigInt64Array",
      "BigUint64Array"
    ],
    "rules": {
      "@typescript-eslint/promise-function-async": "off",
      "@typescript-eslint/no-empty-function": "off",
      "@typescript-eslint/explicit-function-return-type": "off"
    }
  }
}
