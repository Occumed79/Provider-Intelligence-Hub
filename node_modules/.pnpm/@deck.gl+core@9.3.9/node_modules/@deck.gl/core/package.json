{
  "name": "@deck.gl/core",
  "description": "deck.gl core library",
  "license": "MIT",
  "type": "module",
  "version": "9.3.9",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webgl",
    "visualization",
    "overlay",
    "layer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "debug.min.js",
    "dist.min.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build-debugger": "ocular-bundle ./bundle/debug.ts --output=./debug.min.js --globalName=deck.debug",
    "build-bundle": "ocular-bundle ./bundle/index.ts",
    "prepublishOnly": "npm run build-debugger && npm run build-bundle && npm run build-bundle -- --env=dev"
  },
  "gitHead": "f8a9c475a097c10b27d01352c551c7c959b6213d"
}
